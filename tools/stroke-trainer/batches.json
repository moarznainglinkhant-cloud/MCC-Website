{
 "about": "Which letters were made with which version of the MCC Stroke Trainer, and every choice Moarz made for each (the writing order: which piece, where the pen starts, direction). The bands in js/learn-bands.js are the trainer's output for these choices. To redo a batch (a newer trainer, or a different direction), see README.md.",
 "trainer": "https://claude.ai/artifact/Y9K5RXHJi7bxJyQGfxsSNL",
 "versions": {
  "4.0": {
   "file": "trainer-v4.0.html",
   "artifact_version": "1795202290-ad1c",
   "date": "2026-11-20",
   "what": "Bands between the font's two borders. Each font shape is a piece; overlapping shapes are swept whole (both own the overlap)."
  },
  "4.1": {
   "file": "trainer-v4.1.html",
   "artifact_version": "1795203743-c23c",
   "date": "2026-11-20",
   "what": "Overlaps cut by click order: the piece clicked first keeps the overlap; a later piece is cut along the earlier one's border, and the cut becomes one of its ends."
  },
  "4.2": {
   "file": "trainer-v4.2.html",
   "artifact_version": "1795205271-34f0",
   "date": "2026-11-20",
   "what": "Fix for cuts that bulge away from the band (e.g. sa: the inner band meets the ring's inner border): the band first sweeps along the cut edge, so no sliver is left. Saves now include tool. Gives byte-identical bands to 4.1 for batches 1 and 2."
  },
  "4.3": {
   "file": "trainer-v4.3.html",
   "artifact_version": "1795206776-8520",
   "date": "2026-11-20",
   "what": "Sharp corners of the borders are always kept in the sweep, and every end's edge is swept where it bulges away from the band, so a band fills the letter exactly (corners included). Letters drawn in one stroke whose sharp turns look like stroke ends start with those ends switched off (PRESET_IGN: ဋ ဌ ဍ ဠ)."
  },
  "4.4": {
   "file": "trainer-v4.4.html",
   "artifact_version": "1795218859-8535",
   "date": "2026-11-20",
   "what": "Cuts can be arcs (snap to the c's inner arc + stroke width) or the font's own outline (t:'poly'); preset cuts/ends for some letters; a cut that crosses a band is exactly one end; band edges never paired across empty space; band edges on a cut are put exactly on the cut line (no hairline)."
  },
  "4.5": {
   "file": "trainer-v4.5.html",
   "artifact_version": "1795220415-4bd3",
   "date": "2026-11-20",
   "what": "Cuts given point by point (poly), move-only: ma's two cuts are the U's outer edge moved in by the stroke width, one per side, dragged into place. Arrows in the order view stop short of slanted ends (display only)."
  },
  "4.6": {
   "file": "trainer-v4.6.html",
   "artifact_version": "1795236826-65a9",
   "date": "2026-11-20",
   "what": "v4.5 plus, for ba only: the ring's two pointed tips preset as its ends; an end a cut shrank to a point is dropped; the top curve's two slivers beside the ring's tips go to the ring (the ring's inner edge carried on along its own curve up to the top curve's upper edge). Ring must be clicked first. (The live artifact at that version also holds an abandoned experimental ha cut, not used.)"
  },
  "4.7": {
   "file": "trainer-v4.7.html",
   "artifact_version": "1795237300-56f8",
   "date": "2026-11-21",
   "what": "v4.6 plus, for ha only: Moarz's cut drawn in Figma (from the junction corner down to the right circle's edge; the part along the left circle's own edge dropped, so no hairline sliver) and preset ends per piece: the left circle's two tips, the right circle's start along the cut and its tail."
  },
  "marks-4.0": {
   "file": "trainer-marks-v4.0.html",
   "artifact": "https://claude.ai/artifact/GFHVW7uAfAHUWXNj6yrV3R",
   "artifact_version": "1795288632-7eec",
   "date": "2026-11-21",
   "what": "Marks trainer: v4.0 loaded with the 33 non-consonant glyphs (vowel signs, medials, marks, short letter forms). Rings start on the vertical line through their centre (top or bottom), cut exactly along it; the quarter clicked sets the way round. Saved-dot grid bug fixed."
  },
  "marks-4.1": {
   "file": "trainer-marks-v4.1.html",
   "artifact": "https://claude.ai/artifact/GFHVW7uAfAHUWXNj6yrV3R",
   "artifact_version": "1795299119-c46e",
   "date": "2026-11-21",
   "what": "marks-4.0 plus preset cuts (locked, no handles, kept by Clear). ျွ 443: the wa ring's outer edge across the join with ya pin's foot as one perfect circle through the two corners where the font's outer edge stops, centre on their bisector nearest the hole's centre. Cut type kept in drafts and saves."
  }
 },
